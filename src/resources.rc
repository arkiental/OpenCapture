// Version information and application manifest.
#include <winver.h>
#include "version.h"

1 24 "OpenCapture.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OC_VERSION_MAJOR, OC_VERSION_MINOR, OC_VERSION_PATCH, 0
 PRODUCTVERSION OC_VERSION_MAJOR, OC_VERSION_MINOR, OC_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenCapture contributors"
            VALUE "FileDescription", "OpenCapture - open-source screen capture"
            VALUE "FileVersion", OC_VERSION_STR
            VALUE "InternalName", "OpenCapture"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "OpenCapture.exe"
            VALUE "ProductName", "OpenCapture"
            VALUE "ProductVersion", OC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
